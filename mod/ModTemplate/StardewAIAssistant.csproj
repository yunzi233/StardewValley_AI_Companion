<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>StardewAIAssistant</AssemblyName>
    <RootNamespace>StardewAIAssistant</RootNamespace>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- 注意：这里必须是星露谷游戏路径 -->
    <GamePath>D:\Steam\steamapps\common\Stardew Valley</GamePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.1.0" />
    <!-- Harmony 由 SMAPI 4 自带（smapi-internal/0Harmony.dll），只编译引用、不随 Mod 复制 -->
    <Reference Include="0Harmony">
      <HintPath>$(GamePath)\smapi-internal\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- GenericModConfigMenu：由玩家自行安装，只编译引用、不随 Mod 复制 -->
    <Reference Include="GenericModConfigMenu">
      <HintPath>libs\GenericModConfigMenu.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>